{
  "name": "ngx-drag-drop-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:lib": "ng build dnd",
    "watch:lib": "ng build dnd --watch --configuration development",
    "lint": "prettier --check .",
    "publish:stable": "pnpm publish ./dist/ngx-drag-drop",
    "publish:next": "pnpm publish ./dist/ngx-drag-drop --tag next",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prettier": "pnpm exec prettier --write ."
  },
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@angular/common": "^21.2.6",
    "@angular/compiler": "^21.2.6",
    "@angular/core": "^21.2.6",
    "@angular/platform-browser": "^21.2.6",
    "@angular/platform-browser-dynamic": "^21.2.6",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.3.1",
    "@angular/build": "21.2.4",
    "@angular/cli": "21.2.4",
    "@angular/compiler-cli": "21.2.6",
    "@types/node": "24.12.0",
    "@vitest/coverage-v8": "4.1.2",
    "jsdom": "29.0.1",
    "ng-packagr": "21.2.1",
    "prettier": "3.5.3",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  }
}
